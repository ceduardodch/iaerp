# Secrets and local configuration
.env
.env.*
!.env.example
# Cualquier archivo terminado en .env, no solo el llamado exactamente asi.
# `.env` y `.env.*` NO cubren `base_maestra-local-readonly.env`, y un
# archivo de credenciales visible para git es cuestion de tiempo.
*.env
!*.env.example
# Carpeta para credenciales locales. Va ignorada COMPLETA y antes de que
# exista: un secreto ahi dentro no debe depender de que alguien se acuerde
# de agregar la regla el dia que crea el archivo.
.secrets/
*.pem
*.key
*.p12
*.pfx
secrets/
backend/certs/

# Production and personal data
uploads/
documents/
*.xml
*.pdf
*.xlsx
*.xls
*.csv

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
*.db
*.db-journal

# Node
node_modules/
dist/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# IDE and OS
.DS_Store
.idea/
.vscode/
.zcode/

# Runtime
*.log
tmp/
.cache/
graphify-out/
listas/
