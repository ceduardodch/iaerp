APP_ENV=development
DATABASE_URL=postgresql+asyncpg://iaerp:change-me@localhost:5432/iaerp
AUTH_MODE=dev
DEV_JWT_SECRET=replace-with-at-least-32-random-characters
OIDC_ISSUER_URL=http://localhost:8080/realms/iaerp
OIDC_JWKS_URL=
OIDC_API_AUDIENCE=iaerp-api
OIDC_MCP_AUDIENCE=http://localhost:8000/mcp
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MCP_SERVER_URL=http://localhost:8000/mcp
REDIS_URL=redis://localhost:6379/0
MCP_ENABLED=true
IAERP_SECRETS_ENCRYPTION_KEY=replace-with-a-fernet-key
PUBLIC_APP_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/crm/integrations/google/callback
WHATSAPP_GRAPH_VERSION=v23.0
EVOLUTION_API_BASE_URL=
PUBLIC_API_URL=

# --- Fuentes de prospección (solo lectura) --------------------------------
# Los valores reales van en backend/.env, que esta en .gitignore. NUNCA aqui.
#
# Servicio de comprobantes: basta la clave admin para leer la cartera propia
# (GET /admin/tenants). No se usan comprobantes de clientes para prospectar.
FRACTALSOFT_API_URL=https://api.fractalsoft.io
FRACTALSOFT_ADMIN_KEY=
#
# Conexion directa a una BD de origen, si la API no alcanza. Usar SIEMPRE un
# usuario de SOLO LECTURA creado para esto: una cadena de admin da acceso a
# todo, incluidas columnas sensibles que este trabajo no necesita.
PROSPECT_SOURCE_URL=
